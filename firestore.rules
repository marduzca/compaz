rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  	match /stations/{station_id} {
      allow read: if true;
    }
    match /lines/{line_id} {
      allow read: if true;
    }
    match /metadata/{category_id} {
      allow read: if true;
    }
    match /message/{message_id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'message', 'timestamp'])
        && request.resource.data.keys().hasAll(['name', 'email', 'message', 'timestamp'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 200
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 5000
        && request.resource.data.timestamp is timestamp
        && message_id.size() <= 400;
    }
  }
}