{
  "name": "compaz",
  "version": "0.23.0",
  "private": true,
  "scripts": {
    "start": "vite",
    "start:pwa": "npm run build && vite preview",
    "typecheck": "tsc && tsc -p tsconfig.node.json && tsc -p cypress/tsconfig.json",
    "build": "npm run typecheck && vite build",
    "serve": "vite preview",
    "pre-commit": "npm run build && npm test && npm run chromatic",
    "test": "npm run lint && vitest run",
    "only-test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0 && prettier --check 'src/**/*.{js,ts,tsx,css,json,html}'",
    "lint:fix": "eslint . --fix && prettier --write 'src/**/*.{js,ts,tsx,css,json,html}'",
    "release:major": "npm version major",
    "release:minor": "npm version minor && git push",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "cypress:open": "cypress open",
    "cypress:ci": "cypress run",
    "ci:cypress-run": "start-server-and-test start http://localhost:3000 cypress:ci",
    "chromatic": "chromatic --force-rebuild"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/material": "^9.5.0",
    "@react-google-maps/api": "^2.18.1",
    "dijkstrajs": "^1.0.2",
    "downshift": "^9.0.4",
    "firebase": "^13.2.0",
    "i18next": "^26.7.2",
    "i18next-browser-languagedetector": "^8.0.0",
    "i18next-http-backend": "^4.0.10",
    "re-resizable": "^6.9.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.13",
    "react-router": "^8.5.1",
    "react-transition-group": "^4.4.5"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-links": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/google.maps": "^3.55.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-transition-group": "^4.4.5",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "chromatic": "^18.14.1",
    "cypress": "^16.2.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest-dom": "^5.0.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.6",
    "eslint-plugin-testing-library": "^7.0.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "mockdate": "^3.0.5",
    "prettier": "^3.0.0",
    "start-server-and-test": "^3.0.13",
    "storybook": "^10.6.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "prettier": {
    "singleQuote": true
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5"
  }
}
